# Tube Trek — API Keys & Production Config
# Copy this file to .env (git-ignored) — never commit your actual .env

# Recommended: Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Stock Imagery & Video (pexels.com/api · pixabay.com/api/docs)
PEXELS_API_KEY=
