# Backup AI Providers (console.groq.com/keys · openrouter.ai/keys)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Voiceover Engine: "edge-tts" (free, no key required) or "elevenlabs"
VOICE_ENGINE=edge-tts
ELEVENLABS_API_KEY=
